rload vout vdd {r10000}
m1 drain_m1 vin 0 0 nmos W={wn50} L={ln50}
m2 vout vbias drain_m1 drain_m1 nmos W={wn50} L={ln50}
vvbias vbias 0 {b1*vdd}
.include "analysis.inc"
.end
